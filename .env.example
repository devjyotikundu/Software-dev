# Copy this file to .env and fill in real values. Never commit .env.
# DJANGO_SETTINGS_MODULE is chosen by manage.py (development) or set in your
# hosting environment (config.settings.production); it cannot be set here.

# --- Core ---
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC
LOG_LEVEL=INFO
ADMIN_URL=admin/

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/language_exchange
DB_CONN_MAX_AGE=60

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Language Exchange Matcher <noreply@localhost>

# --- Optional admin account (created by seed_data; safe on every deploy) ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Production only ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0

# --- Real-time exchange rooms ---
# Optional locally (an in-memory fallback is used); required in production.
REDIS_URL=

# --- Optional AI assistance ---
# Leave AI_PROVIDER empty to switch AI features off.
# anthropic: AI_MODEL e.g. claude-haiku-4-5-20251001
# openai:    any OpenAI-compatible endpoint; set AI_BASE_URL (e.g. https://api.openai.com/v1)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
